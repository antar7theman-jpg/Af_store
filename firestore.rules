rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Store Owner: Deffas antar (Antar7theman@gmail.com)
    function isStoreOwner() {
      return isSignedIn() &&
             'email_verified' in request.auth.token &&
             request.auth.token.email_verified == true &&
             'email' in request.auth.token &&
             request.auth.token.email.lower() == 'antar7theman@gmail.com';
    }

    // Regular Independent Manager: registered in /admins/{uid}
    function isRegularManager() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return isStoreOwner() || isRegularManager();
    }

    // Helper: Checks if a worker record is affiliated with the calling manager (or unassigned pending worker)
    function isAffiliatedWithCallingManager(data) {
      let parentUid = data.get('parentManagerUid', '');
      return data.role == 'worker' && (
        parentUid == '' ||
        parentUid == request.auth.uid ||
        data.get('approvedByUid', '') == request.auth.uid
      );
    }

    function isValidStaffAccount(data) {
      let requiredKeys = [
        'userId', 'storeId', 'email', 'fullName', 'phone',
        'requestedRole', 'role', 'approvalStatus',
        'approvedByUid', 'approvedByName',
        'canMakeSales', 'canManageInventory', 'canEditPrices',
        'canViewReports', 'canManageDebtsAndCustomers', 'canRefundOrVoid',
        'canApplyDiscounts', 'canViewCostPrices', 'canExportData',
        'canManagePurchaseInvoices',
        'createdAt', 'updatedAt'
      ];
      let allowedKeys = [
        'userId', 'storeId', 'email', 'fullName', 'phone',
        'requestedRole', 'role', 'approvalStatus',
        'approvedByUid', 'approvedByName',
        'parentManagerUid', 'parentManagerName', 'parentManagerEmail',
        'branchName', 'secretPin',
        'activeDeviceId', 'activeDeviceName', 'activeSessionToken',
        'isTrial', 'trialEndsAtMillis', 'isApprovedByOwner', 'syncMode',
        'canMakeSales', 'canManageInventory', 'canEditPrices',
        'canViewReports', 'canManageDebtsAndCustomers', 'canRefundOrVoid',
        'canApplyDiscounts', 'canViewCostPrices', 'canExportData',
        'canManagePurchaseInvoices',
        'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(requiredKeys) &&
             data.keys().hasOnly(allowedKeys) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.storeId is string && data.storeId == 'af_store' &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
             data.phone is string && data.phone.size() >= 0 && data.phone.size() <= 30 &&
             data.requestedRole in ['worker', 'manager', 'admin', 'owner'] &&
             data.role in ['worker', 'manager', 'admin', 'owner'] &&
             data.approvalStatus in ['PENDING', 'APPROVED', 'REJECTED', 'SUSPENDED'] &&
             data.approvedByUid is string && data.approvedByUid.size() <= 128 &&
             data.approvedByName is string && data.approvedByName.size() <= 100 &&
             (!('parentManagerUid' in data) || (data.parentManagerUid is string && data.parentManagerUid.size() <= 128)) &&
             (!('parentManagerName' in data) || (data.parentManagerName is string && data.parentManagerName.size() <= 100)) &&
             (!('parentManagerEmail' in data) || (data.parentManagerEmail is string && data.parentManagerEmail.size() <= 150)) &&
             (!('branchName' in data) || (data.branchName is string && data.branchName.size() <= 100)) &&
             (!('secretPin' in data) || (data.secretPin is string && data.secretPin.size() <= 64)) &&
             (!('activeDeviceId' in data) || (data.activeDeviceId is string && data.activeDeviceId.size() <= 128)) &&
             (!('activeDeviceName' in data) || (data.activeDeviceName is string && data.activeDeviceName.size() <= 128)) &&
             (!('activeSessionToken' in data) || (data.activeSessionToken is string && data.activeSessionToken.size() <= 128)) &&
             (!('isTrial' in data) || data.isTrial is bool) &&
             (!('trialEndsAtMillis' in data) || data.trialEndsAtMillis is int) &&
             (!('isApprovedByOwner' in data) || data.isApprovedByOwner is bool) &&
             (!('syncMode' in data) || data.syncMode in ['pro', 'offline', 'lite']) &&
             data.canMakeSales is bool &&
             data.canManageInventory is bool &&
             data.canEditPrices is bool &&
             data.canViewReports is bool &&
             data.canManageDebtsAndCustomers is bool &&
             data.canRefundOrVoid is bool &&
             data.canApplyDiscounts is bool &&
             data.canViewCostPrices is bool &&
             data.canExportData is bool &&
             data.canManagePurchaseInvoices is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidAdminRecord(data) {
      let allowedKeys = ['userId', 'storeId', 'email', 'fullName', 'createdAt'];
      return data.keys().hasAll(allowedKeys) &&
             data.keys().hasOnly(allowedKeys) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.storeId is string && data.storeId == 'af_store' &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
             data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidProUpgradeRequest(data) {
      let requiredKeys = ['requestId', 'managerUid', 'phone', 'status', 'requestedAt'];
      let allowedKeys = [
        'requestId', 'managerUid', 'managerName', 'managerEmail',
        'phone', 'branchName', 'status', 'note',
        'requestedAt', 'reviewedAt', 'reviewedByUid'
      ];
      return data.keys().hasAll(requiredKeys) &&
             data.keys().hasOnly(allowedKeys) &&
             data.requestId is string && data.requestId.size() >= 1 && data.requestId.size() <= 128 &&
             data.managerUid is string && data.managerUid.size() >= 1 && data.managerUid.size() <= 128 &&
             data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 30 &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED', 'LITE_ACCOUNT_CREATED'] &&
             (!('managerName' in data) || (data.managerName is string && data.managerName.size() <= 100)) &&
             (!('managerEmail' in data) || (data.managerEmail is string && data.managerEmail.size() <= 150)) &&
             (!('branchName' in data) || (data.branchName is string && data.branchName.size() <= 100)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
             data.requestedAt is timestamp && data.requestedAt <= request.time &&
             (!('reviewedAt' in data) || (data.reviewedAt is timestamp && data.reviewedAt <= request.time)) &&
             (!('reviewedByUid' in data) || (data.reviewedByUid is string && data.reviewedByUid.size() <= 128));
    }

    function isValidProduct(data) {
      let allowedKeys = [
        'id', 'firestoreId', 'userId', 'name', 'purchasePrice', 'price', 'salePrice',
        'stock', 'quantityInUnits', 'unitsPerCarton', 'barcode', 'cartonBarcode',
        'category', 'minStockAlert', 'minStockThreshold', 'imagePath', 'imageUrl',
        'isDeleted', 'syncStatus', 'serverUpdatedAt', 'updatedAt', 'createdAt'
      ];
      return data.keys().hasOnly(allowedKeys) &&
             (!('name' in data) || (data.name is string && data.name.size() <= 200)) &&
             (!('price' in data) || (data.price is int || data.price is float)) &&
             (!('salePrice' in data) || (data.salePrice is int || data.salePrice is float)) &&
             (!('stock' in data) || (data.stock is int || data.stock is float)) &&
             (!('quantityInUnits' in data) || (data.quantityInUnits is int || data.quantityInUnits is float));
    }

    function isValidPurchaseInvoice(data) {
      let allowedKeys = [
        'id', 'numId', 'supplierName', 'supplierPhone', 'invoiceNumber', 'invoiceDate',
        'dateMillis', 'totalCost', 'paidAmount', 'remainingDebt', 'paymentStatus',
        'notes', 'itemsJson', 'itemsCount', 'syncStatus', 'serverUpdatedAt',
        'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(['id', 'supplierName', 'totalCost']) &&
             data.keys().hasOnly(allowedKeys) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             data.supplierName is string && data.supplierName.size() <= 150 &&
             (data.totalCost is int || data.totalCost is float);
    }

    function isValidSaleTransaction(data) {
      let allowedKeys = ['id', 'totalAmount', 'cashierUid', 'cashierName', 'timestamp', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(['id', 'totalAmount', 'timestamp']) &&
             data.keys().hasOnly(allowedKeys) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
             (data.totalAmount is int || data.totalAmount is float) &&
             data.timestamp is int;
    }

    function isValidCloudInvoice(data) {
      let allowedKeys = [
        'invoiceId', 'dateMillis', 'customerName', 'customerId', 'paymentMethod',
        'isDebt', 'subtotal', 'totalQuantity', 'orderType', 'status',
        'expectedDeliveryDate', 'notes', 'customerLocationUrl', 'workerName',
        'workerUid', 'items', 'serverUpdatedAt', 'updatedAt'
      ];
      return data.keys().hasAll(['invoiceId', 'dateMillis']) &&
             data.keys().hasOnly(allowedKeys) &&
             data.invoiceId is string && data.invoiceId.size() >= 1 && data.invoiceId.size() <= 128 &&
             data.dateMillis is int;
    }

    function isValidWorkerLocation(data) {
      let allowedKeys = [
        'userId', 'workerName', 'latitude', 'longitude',
        'statusNote', 'timestamp', 'serverUpdatedAt'
      ];
      return data.keys().hasAll(['userId', 'workerName', 'latitude', 'longitude']) &&
             data.keys().hasOnly(allowedKeys) &&
             data.userId is int &&
             data.workerName is string && data.workerName.size() <= 120 &&
             (data.latitude is int || data.latitude is float) &&
             (data.longitude is int || data.longitude is float);
    }

    function isValidCloudBackup(data) {
      let allowedKeys = [
        'userId', 'fileName', 'dateMillis', 'formattedDate',
        'sizeBytes', 'base64Data', 'updatedAt'
      ];
      return data.keys().hasAll(['userId', 'fileName', 'base64Data', 'updatedAt']) &&
             data.keys().hasOnly(allowedKeys) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 200 &&
             data.base64Data is string && data.base64Data.size() <= 950000 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /staff_accounts/{accountId} {
      allow get: if isSignedIn() && isValidId(accountId) && (
        request.auth.uid == accountId ||
        isStoreOwner() ||
        (isRegularManager() && (resource == null || isAffiliatedWithCallingManager(resource.data))) ||
        (resource != null && 'email' in request.auth.token && resource.data.email.lower() == request.auth.token.email.lower())
      );

      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.storeId == 'af_store' && isStoreOwner()) ||
        (resource.data.storeId == 'af_store' && isRegularManager() && isAffiliatedWithCallingManager(resource.data)) ||
        ('email' in request.auth.token && resource.data.email.lower() == request.auth.token.email.lower())
      );

      allow create: if isSignedIn() &&
                       isValidId(accountId) &&
                       isValidStaffAccount(incoming()) &&
                       incoming().userId == accountId && (
                         // Action 1: Self-registration as pending worker ONLY
                         (
                           request.auth.uid == accountId &&
                           incoming().approvalStatus == 'PENDING' &&
                           incoming().role == 'worker' &&
                           incoming().requestedRole == 'worker' &&
                           incoming().approvedByUid == '' &&
                           incoming().approvedByName == ''
                         ) ||
                         // Action 2: Store Owner (Deffas antar - Antar7theman@gmail.com) creating or bootstrapping any account
                         isStoreOwner() ||
                         // Action 3: Independent Manager creating an affiliated worker account belonging to them
                         (
                           isRegularManager() &&
                           incoming().role == 'worker' &&
                           incoming().requestedRole == 'worker' &&
                           incoming().get('parentManagerUid', request.auth.uid) == request.auth.uid
                         ) ||
                         // Action 4: Pre-provisioned Manager or Worker claiming their UID document when matching their verified email
                         (
                           request.auth.uid == accountId &&
                           incoming().role in ['manager', 'worker'] &&
                           incoming().approvalStatus == 'APPROVED' &&
                           'email' in request.auth.token &&
                           'email_verified' in request.auth.token &&
                           request.auth.token.email_verified == true &&
                           incoming().email.lower() == request.auth.token.email.lower()
                         )
                       );

      allow update: if isSignedIn() &&
                       resource != null &&
                       isValidId(accountId) &&
                       isValidStaffAccount(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().storeId == existing().storeId &&
                       incoming().email == existing().email &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Staff member updating only their personal contact details or active device session while keeping role, status & permissions intact
                         (
                           request.auth.uid == accountId &&
                           incoming().requestedRole == 'worker' &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'fullName', 'phone', 'requestedRole',
                             'activeDeviceId', 'activeDeviceName', 'activeSessionToken',
                             'updatedAt'
                           ])
                         ) ||
                         // Action 2: Store Owner (Deffas antar) can approve, promote, or update any Worker or Independent Manager account
                         (
                           isStoreOwner() &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'fullName', 'phone', 'requestedRole', 'role', 'approvalStatus',
                             'approvedByUid', 'approvedByName',
                             'parentManagerUid', 'parentManagerName', 'parentManagerEmail',
                             'branchName', 'secretPin',
                             'activeDeviceId', 'activeDeviceName', 'activeSessionToken',
                             'isTrial', 'trialEndsAtMillis', 'isApprovedByOwner', 'syncMode',
                             'canMakeSales', 'canManageInventory', 'canEditPrices',
                             'canViewReports', 'canManageDebtsAndCustomers', 'canRefundOrVoid',
                             'canApplyDiscounts', 'canViewCostPrices', 'canExportData',
                             'canManagePurchaseInvoices', 'updatedAt'
                           ])
                         ) ||
                         // Action 3: Independent Manager can ONLY approve, suspend, or update their OWN affiliated WORKER accounts
                         (
                           isRegularManager() &&
                           isAffiliatedWithCallingManager(existing()) &&
                           incoming().role == 'worker' &&
                           incoming().requestedRole == 'worker' &&
                           incoming().get('parentManagerUid', request.auth.uid) == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'fullName', 'phone', 'requestedRole', 'role', 'approvalStatus',
                             'approvedByUid', 'approvedByName',
                             'parentManagerUid', 'parentManagerName', 'parentManagerEmail',
                             'branchName', 'secretPin',
                             'activeDeviceId', 'activeDeviceName', 'activeSessionToken',
                             'isTrial', 'trialEndsAtMillis', 'isApprovedByOwner', 'syncMode',
                             'canMakeSales', 'canManageInventory', 'canEditPrices',
                             'canViewReports', 'canManageDebtsAndCustomers', 'canRefundOrVoid',
                             'canApplyDiscounts', 'canViewCostPrices', 'canExportData',
                             'canManagePurchaseInvoices', 'updatedAt'
                           ])
                         )
                       );

      allow delete: if isSignedIn() && (
        (isStoreOwner() && accountId != request.auth.uid) ||
        (isRegularManager() && resource != null && isAffiliatedWithCallingManager(existing()) && accountId != request.auth.uid) ||
        (resource != null && 'email' in request.auth.token && existing().email.lower() == request.auth.token.email.lower() && accountId != request.auth.uid)
      );
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (
        request.auth.uid == adminId || isAdmin()
      );

      allow list: if isAdmin();

      // Only Store Owner (Deffas antar) or a pre-approved Manager claiming their own UID can create an /admins record
      allow create: if isSignedIn() &&
                       isValidId(adminId) &&
                       isValidAdminRecord(incoming()) &&
                       incoming().userId == adminId && (
                         isStoreOwner() ||
                         (
                           request.auth.uid == adminId &&
                           exists(/databases/$(database)/documents/staff_accounts/$(request.auth.uid)) &&
                           get(/databases/$(database)/documents/staff_accounts/$(request.auth.uid)).data.role == 'manager' &&
                           get(/databases/$(database)/documents/staff_accounts/$(request.auth.uid)).data.approvalStatus == 'APPROVED'
                         )
                       );

      allow update: if isStoreOwner() &&
                       resource != null &&
                       isValidId(adminId) &&
                       isValidAdminRecord(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().storeId == existing().storeId &&
                       incoming().createdAt == existing().createdAt;

      allow delete: if isStoreOwner() && adminId != request.auth.uid;
    }

    match /pro_upgrade_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        request.auth.uid == requestId ||
        (resource != null && resource.data.managerUid == request.auth.uid) ||
        isStoreOwner()
      );

      allow list: if isSignedIn() && (
        resource.data.managerUid == request.auth.uid ||
        isStoreOwner()
      );

      allow create: if isSignedIn() &&
                       isValidId(requestId) &&
                       isValidProUpgradeRequest(incoming()) &&
                       incoming().requestId == requestId &&
                       (incoming().managerUid == request.auth.uid || isStoreOwner() || isRegularManager());

      allow update: if isSignedIn() &&
                       resource != null &&
                       isValidId(requestId) &&
                       isValidProUpgradeRequest(incoming()) &&
                       incoming().requestId == existing().requestId &&
                       incoming().managerUid == existing().managerUid && (
                         isStoreOwner() ||
                         (
                           request.auth.uid == existing().managerUid &&
                           incoming().status == 'PENDING' &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['phone', 'note', 'branchName', 'requestedAt'])
                         )
                       );

      allow delete: if isStoreOwner();
    }

    match /users/{userId}/products/{productId} {
      allow get, list: if isSignedIn() && isValidId(userId);
      allow create, update: if isSignedIn() &&
                               isValidId(userId) &&
                               isValidId(productId) &&
                               isValidProduct(incoming());
      allow delete: if isSignedIn() && isValidId(userId) && isValidId(productId);
    }

    match /users/{userId}/purchase_invoices/{invoiceId} {
      allow get, list: if isSignedIn() && isValidId(userId);
      allow create, update: if isSignedIn() &&
                               isValidId(userId) &&
                               isValidId(invoiceId) &&
                               isValidPurchaseInvoice(incoming());
      allow delete: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/sales/{saleId} {
      allow get, list: if isSignedIn() && isValidId(userId);
      allow create, update: if isSignedIn() &&
                               isValidId(userId) &&
                               isValidId(saleId) &&
                               isValidSaleTransaction(incoming());
      allow delete: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/invoices/{invoiceId} {
      allow get, list: if isSignedIn() && isValidId(userId);
      allow create, update: if isSignedIn() &&
                               isValidId(userId) &&
                               isValidId(invoiceId) &&
                               isValidCloudInvoice(incoming());
      allow delete: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/worker_locations/{workerId} {
      allow get, list: if isSignedIn() && isValidId(userId);
      allow create, update: if isSignedIn() &&
                               isValidId(userId) &&
                               isValidId(workerId) &&
                               isValidWorkerLocation(incoming());
      allow delete: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/location_history/{historyId} {
      allow get, list: if isSignedIn() && isValidId(userId);
      allow create, update: if isSignedIn() &&
                               isValidId(userId) &&
                               isValidId(historyId) &&
                               isValidWorkerLocation(incoming());
      allow delete: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    match /users/{userId}/cloud_backups/{backupId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() &&
                               isValidId(userId) &&
                               isValidId(backupId) &&
                               request.auth.uid == userId &&
                               incoming().userId == userId &&
                               isValidCloudBackup(incoming());
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /worker_locations/{workerId} {
      allow get: if isSignedIn() && isValidId(workerId) && isAdmin();
      allow list: if isSignedIn() && isAdmin();
      allow create, update: if isSignedIn() &&
                               isValidId(workerId) &&
                               isValidWorkerLocation(incoming());
      allow delete: if isSignedIn() && isStoreOwner();
    }

    match /stores/{storeId}/products/{productId} {
      allow get, list: if isSignedIn() && isValidId(storeId) && storeId == 'af_store';
      allow create, update: if isSignedIn() &&
                               isValidId(storeId) &&
                               storeId == 'af_store' &&
                               isValidId(productId) &&
                               isValidProduct(incoming()) &&
                               isAdmin();
      allow delete: if isSignedIn() && isValidId(storeId) && storeId == 'af_store' && isAdmin();
    }

    match /_system_health_checks/{checkId} {
      allow read, write: if true;
    }
  }
}
